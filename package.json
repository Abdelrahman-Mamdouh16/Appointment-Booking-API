{
  "name": "appointment-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for the Appointment Booking API assessment",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm db:generate && pnpm db:migrate:deploy && pnpm db:seed",
    "postinstall": "prisma generate",
    "socket:client": "tsx scripts/socket-client.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:db:setup": "tsx scripts/test-db.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "joi": "^18.2.9",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prisma": "6.16.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.1"
  }
}